<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.murkantor.perfect_dark_netplay</id>
  <name>Perfect Dark Netplay</name>
  <developer id="io.github.murkantor">
    <name>Perfect Dark Netplay Contributors</name>
    <url>https://github.com/murkantor/perfect_dark_netplay/graphs/contributors</url>
  </developer>
  <launchable type="desktop-id">io.github.murkantor.perfect_dark_netplay.desktop</launchable>
  <summary>Perfect Dark port with internet/LAN multiplayer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <url type="homepage">https://github.com/murkantor/perfect_dark_netplay/</url>
  <url type="bugtracker">https://github.com/murkantor/perfect_dark_netplay/issues</url>
  <description>
    <p>A port of the Perfect Dark decompilation to modern systems, extended with experimental client-server netplay: internet/LAN Combat Simulator matches for up to 8 players, dedicated servers, a server browser, and online co-operative play (work in progress).</p>
    <p>This application requires a Perfect Dark ROM (NTSC "final"/v1.1) which must be supplied by the user. Place it at ~/.var/app/io.github.murkantor.perfect_dark_netplay/data/roms/pd.ntsc-final.z64</p>
  </description>
  <categories>
    <category>Game</category>
    <category>ActionGame</category>
    <category>Shooter</category>
  </categories>
  <keywords>
    <keyword>n64</keyword>
    <keyword>decompilation</keyword>
    <keyword>shooter</keyword>
    <keyword>multiplayer</keyword>
    <keyword>netplay</keyword>
  </keywords>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="violence-bloodshed">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
</component>
